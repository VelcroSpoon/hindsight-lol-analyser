# Copy this file to .env.local and fill in your Riot dev API key.
# Get a key at https://developer.riotgames.com/ (dev keys expire every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Which of Riot's regional servers to use for looking up accounts. Any of them
# can find any player, so pick the one nearest you: americas | asia | europe | sea.
# Players from every region work: each player's games are fetched from their own
# region automatically.
RIOT_REGION=americas
