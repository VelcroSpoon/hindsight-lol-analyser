# Copy this file to .env.local and fill in your Riot dev API key.
# Get a key at https://developer.riotgames.com/ (dev keys expire every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Regional routing value used for Account-V1 and Match-V5.
# One of: americas | asia | europe | sea
# (Pick the one for the account's home region: NA/BR/LAN/LAS -> americas,
#  KR/JP -> asia, EUW/EUNE/TR/RU -> europe, OCE/SEA -> sea)
RIOT_REGION=americas
